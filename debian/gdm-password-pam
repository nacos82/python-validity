#!/usr/bin/python3
"""Keep pam_fprintd out of GDM's password conversation.

GDM runs fingerprint authentication in its own gdm-fingerprint conversation. Its
gdm-password service includes common-auth, which also runs pam_fprintd when
fingerprint login is enabled for sudo. Both conversations then race to claim the
sensor, and when the password one wins it gives a single try (common-auth's
max-tries) before falling back to the password.

"apply" replaces gdm-password's "@include common-auth" with a copy of
common-auth's auth lines minus pam_fprintd, between marker comments, and
refreshes that copy if it is already there. "revert" puts the include back.

Usage: gdm-password-pam apply|revert [gdm-password path] [common-auth path]
"""
import os
import re
import sys
import tempfile

BEGIN = '# BEGIN python3-validity: common-auth without pam_fprintd (gdm-fingerprint handles it)'
END = '# END python3-validity'
INCLUDE = '@include common-auth'


def auth_lines_without_fprintd(common_auth: str) -> list:
    lines = [l for l in common_auth.splitlines()
             if l.strip() and not l.lstrip().startswith('#') and l.split()[0] == 'auth']
    # Drop pam_fprintd lines one at a time, shortening any earlier jump that crossed them.
    while True:
        idx = next((i for i, l in enumerate(lines) if 'pam_fprintd.so' in l), None)
        if idx is None:
            return lines
        for i in range(idx):
            m = re.match(r'(\s*auth\s+)(\[[^\]]*\])(.*)', lines[i])
            if not m:
                continue  # simple control word such as "required": no jump

            def shorten(j, i=i):
                n = int(j.group(2))
                return '%s=%d' % (j.group(1), n - 1 if i + n >= idx else n)
            lines[i] = m.group(1) + re.sub(r'(\w+)=(\d+)', shorten, m.group(2)) + m.group(3)
        del lines[idx]


def strip_block(text: str) -> tuple:
    """Return the file with our block replaced by the include, and whether a block was found."""
    out, inside, found = [], False, False
    for line in text.splitlines(keepends=True):
        if line.rstrip('\n') == BEGIN:
            inside, found = True, True
            out.append(INCLUDE + '\n')
            continue
        if inside:
            if line.rstrip('\n') == END:
                inside = False
            continue
        out.append(line)
    return ''.join(out), found


def apply(text: str, common_auth: str) -> str:
    text, _ = strip_block(text)
    lines = text.splitlines(keepends=True)
    hits = [i for i, l in enumerate(lines) if l.strip() == INCLUDE]
    if len(hits) != 1:
        raise SystemExit('expected one "%s" line, found %d; leaving the file alone' % (INCLUDE, len(hits)))
    block = [BEGIN + '\n'] + [l + '\n' for l in auth_lines_without_fprintd(common_auth)] + [END + '\n']
    i = hits[0]
    return ''.join(lines[:i] + block + lines[i + 1:])


def write_atomically(path: str, text: str) -> None:
    st = os.stat(path)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix='.gdm-password.')
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(text)
        os.chmod(tmp, st.st_mode & 0o7777)
        os.chown(tmp, st.st_uid, st.st_gid)
        os.rename(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] not in ('apply', 'revert'):
        raise SystemExit(__doc__)
    gdm_password = sys.argv[2] if len(sys.argv) > 2 else '/etc/pam.d/gdm-password'
    common_auth = sys.argv[3] if len(sys.argv) > 3 else '/etc/pam.d/common-auth'
    if not os.path.exists(gdm_password):
        return  # GDM isn't installed
    with open(gdm_password) as f:
        text = f.read()
    if sys.argv[1] == 'apply':
        with open(common_auth) as f:
            new = apply(text, f.read())
    else:
        new, _ = strip_block(text)
    if new != text:
        write_atomically(gdm_password, new)


if __name__ == '__main__':
    main()
