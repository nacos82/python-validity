[Unit]
Description=python-validity driver dbus service
After=open-fprintd.service

[Service]
Type=simple
# No --debug: it traces every USB and TLS exchange, including the
# sensor pairing's private key, into the journal.
ExecStart=/usr/lib/python-validity/dbus-service
Restart=no

[Install]
WantedBy=multi-user.target
